    "/status": {
      "get": {
        "summary": "当前在干什么：在途请求明细（最久的排最前）",
        "description": "与 /stats 的差别：这里有 inflight 明细（rid / method / path / elapsed_sec）。响应**刻意不含** last_error、代理地址、UA 指纹等高敏字段。",
        "responses": {
          "200": {
            "description": "服务状态 + 在途明细（含嫁接层在途与卡死快照）",
            "headers": {
              "X-Request-Id": {
                "description": "请求级追踪标识（v6.0 T-79）。调用方带合法 X-Request-Id 则沿用，否则服务端生成 12 位 hex。",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "state"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "code": {
                      "type": "integer"
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "ready",
                        "starting",
                        "degraded",
                        "wedged"
                      ]
                    },
                    "pid": {
                      "type": "integer"
                    },
                    "backends": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "cache_backend": {
                      "type": "string"
                    },
                    "uptime_sec": {
                      "type": "number"
                    },
                    "queue_depth": {
                      "type": "integer"
                    },
                    "inflight_count": {
                      "type": "integer"
                    },
                    "inflight": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "multicaptcha_inflight": {
                      "type": "array",
                      "description": "万盾嫁接层（captchas/）正在跑的求解；与主链路 inflight 分列",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          },
                          "started": {
                            "type": "number"
                          }
                        }
                      }
                    },
                    "wedge": {
                      "type": "object",
                      "description": "卡死状态快照（v6.2）",
                      "properties": {
                        "wedged": {
                          "type": "boolean"
                        },
                        "reason": {
                          "type": "string"
                        },
                        "wedge_restart": {
                          "type": "boolean"
                        }
                      }
                    },
                    "events_total": {
                      "type": "integer"
                    },
                    "compat": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized",
            "headers": {
              "X-Request-Id": {
                "description": "请求级追踪标识（v6.0 T-79）。调用方带合法 X-Request-Id 则沿用，否则服务端生成 12 位 hex。",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
