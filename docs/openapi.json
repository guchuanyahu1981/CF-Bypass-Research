{
  "openapi": "3.0.3",
  "info": {
    "title": "CF-Bypass-Research 求解服务",
    "version": "6.4.1",
    "description": "Cloudflare `cf_clearance` / Turnstile token / reCAPTCHA v3 / AWS WAF token 的获取与回放服务。\n\n**这份规格是手写的**（本项目不引入 FastAPI/pydantic，见 policy.md 的『零新依赖』），因此必须由 `scripts/validate-openapi.mjs` 反向核对：规格里声明的 `path + method` 必须与 `solver/service.py` 里实际存在的路由**完全一致**，多一个少一个都报错。\n\n约定：\n- 鉴权：`Authorization: Bearer <token>`；`/health`（容器探活）、`GET /`（只读状态页）与 `OPTIONS`（只回 `Allow`）免鉴权。\n- 错误响应体：2xx 读 `ok`，非 2xx 读 `error_code`（另有 `stage` / `hint` 供自动重试与自助修复）。\n- `POST /shutdown` 额外限制来源必须是回环地址（除非启动时加 `--allow-remote-shutdown`）。\n\n方法语义（所有路径一致）：`HEAD` 等价于 `GET` 的头、无 body；`OPTIONS` → `204` + `Allow`；`PUT`/`DELETE`/`PATCH`/`TRACE`/`CONNECT` → `405` + `error_code=method-not-allowed` + `Allow`（不是 501：这是『该资源不支持这个方法』，不是『服务不认识这个方法』）。\n\n未知路径（不在本规格的 `paths` 里）→ `404` + `error_code=not-found`；未带 token 时一律先 `401`，不泄露『这个路径存不存在』。该响应属于**路由层**、对具体操作不可达，因此不逐操作声明 —— 声明在具体 `path` 下会让代码生成器产出一条永不触发的分支。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8878",
      "description": "默认监听地址"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "启动时自动生成并写入 .env 的 CF_SOLVE_TOKEN"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "ok",
          "error_code"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error_code": {
            "type": "string",
            "enum": [
              "invalid-request",
              "payload-too-large",
              "unauthorized",
              "rate-limited",
              "busy",
              "not-found",
              "method-not-allowed",
              "not-configured",
              "browser-unavailable",
              "timeout",
              "transport",
              "internal",
              "unsolved"
            ]
          },
          "error": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "enum": [
              "validate",
              "admit",
              "solve",
              "internal"
            ]
          },
          "hint": {
            "type": "string",
            "description": "给人看的下一步建议（不是给机器解析的）"
          },
          "request_id": {
            "type": "string",
            "description": "与响应头 X-Request-Id 相同的值（v6.0 T-79）"
          }
        }
      },
      "SolveRequest": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "目标 URL（http/https，长度上限 2048）"
          },
          "timeout": {
            "type": "number",
            "default": 45.0,
            "description": "整条后端链的预算（秒），范围 [5, 120]"
          },
          "want": {
            "type": "string",
            "enum": [
              "",
              "clearance",
              "turnstile",
              "recaptcha_v3",
              "awswaf",
              "turnstile_x",
              "recaptcha_x",
              "hcaptcha",
              "cloudflare_x",
              "awswaf_x",
              "botguard",
              "datadome",
              "perimeterx",
              "akamai",
              "aliyun",
              "arkose"
            ],
            "description": "要哪种凭证；空=clearance（cf_clearance） | v6.1 扩展类型（captchas/ 子包，见 docs/API.md 万盾扩展类型一节）：turnstile_x / recaptcha_x / hcaptcha / cloudflare_x / awswaf_x / botguard / datadome / perimeterx / akamai / aliyun / arkose"
          },
          "sitekey": {
            "type": "string",
            "description": "want=turnstile/recaptcha_v3/awswaf 时必需"
          },
          "action": {
            "type": "string",
            "description": "Turnstile action"
          },
          "cdata": {
            "type": "string",
            "description": "Turnstile cdata"
          },
          "force": {
            "type": "boolean",
            "default": false,
            "description": "跳过缓存强制重新求解"
          },
          "route": {
            "type": "string",
            "enum": [
              "fixed",
              "auto"
            ],
            "default": "fixed",
            "description": "fixed=按后端链求解；auto=先探测，无盾站直接放行（0 次求解）、不支持的防护直接拒绝"
          }
        }
      },
      "SolveResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "solved": {
            "type": "boolean"
          },
          "cached": {
            "type": "boolean"
          },
          "cookies": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "cookie 名 → 值"
          },
          "user_agent": {
            "type": "string"
          },
          "elapsed": {
            "type": "number"
          },
          "expires_at": {
            "type": "number"
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "后端回落轨迹"
          },
          "routed_by": {
            "type": "object",
            "description": "route=auto 时的决策记录"
          },
          "request_id": {
            "type": "string",
            "description": "与响应头 X-Request-Id 相同的值（v6.0 T-79）"
          }
        }
      },
      "DetectRequest": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "fresh": {
            "type": "boolean",
            "default": false,
            "description": "忽略按域探测缓存"
          }
        }
      },
      "CompatTaskRequest": {
        "type": "object",
        "required": [
          "task"
        ],
        "properties": {
          "clientKey": {
            "type": "string",
            "description": "与本服务 Bearer token 相同（YesCaptcha 客户端习惯放 body）"
          },
          "task": {
            "type": "object",
            "required": [
              "type",
              "websiteURL"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "AntiCloudflareTask",
                  "RecaptchaV3TaskProxyless",
                  "TurnstileTaskProxyless"
                ]
              },
              "websiteURL": {
                "type": "string"
              },
              "websiteKey": {
                "type": "string",
                "description": "Turnstile / reCAPTCHA 必填"
              },
              "action": {
                "type": "string",
                "description": "Turnstile action"
              },
              "cdata": {
                "type": "string",
                "description": "Turnstile cdata"
              },
              "pageAction": {
                "type": "string",
                "description": "reCAPTCHA v3 pageAction"
              }
            }
          }
        }
      },
      "CompatError": {
        "type": "object",
        "description": "业务错误一律 HTTP 200 + errorId=1（生态客户端只按 errorId 判断成败）",
        "required": [
          "errorId",
          "errorCode",
          "errorDescription"
        ],
        "properties": {
          "errorId": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "errorCode": {
            "type": "string"
          },
          "errorDescription": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "缺少或错误的 Bearer token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Busy": {
        "description": "队列已满 / 并发已达上限（可重试）",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "summary": "只读状态页（HTML，免鉴权）",
        "description": "单文件 HTML 面板：展示 /health、/status、/logs。页面**不含任何服务端数据**——token 由用户在页面上填入并存于 sessionStorage。",
        "security": [],
        "responses": {
          "200": {
            "description": "text/html；Cache-Control: no-store",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "健康视图（免鉴权；带 token 才给完整运维视图）",
        "security": [],
        "responses": {
          "200": {
            "description": "ready（浏览器在线、worker 活着）",
            "headers": {
              "X-Request-Id": {
                "description": "请求级追踪标识（v6.0 T-79）。调用方带合法 X-Request-Id 则沿用，否则服务端生成 12 位 hex。",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "starting / degraded / wedged —— wedged = worker 卡死，**不会自愈**，服务模式会以退出码 75 退出交 supervisor 重启",
            "headers": {
              "X-Request-Id": {
                "description": "请求级追踪标识（v6.0 T-79）。调用方带合法 X-Request-Id 则沿用，否则服务端生成 12 位 hex。",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/solve": {
      "post": {
        "summary": "求解并返回可回放的凭证",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "求解完成（solved 可能为 false，属正常业务结果）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SolveResponse"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "请求级追踪标识（v6.0 T-79）。调用方带合法 X-Request-Id 则沿用，否则服务端生成 12 位 hex。",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "参数非法（不该重试）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "请求级追踪标识（v6.0 T-79）。调用方带合法 X-Request-Id 则沿用，否则服务端生成 12 位 hex。",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized",
            "headers": {
              "X-Request-Id": {
                "description": "请求级追踪标识（v6.0 T-79）。调用方带合法 X-Request-Id 则沿用，否则服务端生成 12 位 hex。",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "413": {
            "description": "请求体超过 65536 字节上限（常量，无可调参数；可减小后重试）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "请求级追踪标识（v6.0 T-79）。调用方带合法 X-Request-Id 则沿用，否则服务端生成 12 位 hex。",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/Busy",
            "headers": {
              "X-Request-Id": {
                "description": "请求级追踪标识（v6.0 T-79）。调用方带合法 X-Request-Id 则沿用，否则服务端生成 12 位 hex。",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "未预期异常（`error_code=internal`）；拿 `request_id` 去 `/logs` 查同 id 的 `internal` 事件",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "请求追踪标识（v6.0 T-79）。调用方可自带 X-Request-Id（合法则沿用，否则新生成 12 位 hex）",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "502": {
            "description": "网络层失败（`error_code=transport`）：DNS / 连接 / TLS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "请求追踪标识（v6.0 T-79）。调用方可自带 X-Request-Id（合法则沿用，否则新生成 12 位 hex）",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "后端未就绪或浏览器不可用（`error_code=not-configured` / `browser-unavailable`）；看 `/health` 的 `last_error`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "请求追踪标识（v6.0 T-79）。调用方可自带 X-Request-Id（合法则沿用，否则新生成 12 位 hex）",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "504": {
            "description": "超过本次求解预算（`error_code=timeout`）；调大 `timeout`（≤120）或降并发",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "请求追踪标识（v6.0 T-79）。调用方可自带 X-Request-Id（合法则沿用，否则新生成 12 位 hex）",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/detect": {
      "get": {
        "summary": "探测目标站用了什么防护（query 传 url）",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fresh",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "探测结论 + 建议路由",
            "headers": {
              "X-Request-Id": {
                "description": "请求级追踪标识（v6.0 T-79）。调用方带合法 X-Request-Id 则沿用，否则服务端生成 12 位 hex。",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "参数非法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "请求级追踪标识（v6.0 T-79）。调用方带合法 X-Request-Id 则沿用，否则服务端生成 12 位 hex。",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized",
            "headers": {
              "X-Request-Id": {
                "description": "请求级追踪标识（v6.0 T-79）。调用方带合法 X-Request-Id 则沿用，否则服务端生成 12 位 hex。",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/Busy",
            "headers": {
              "X-Request-Id": {
                "description": "请求级追踪标识（v6.0 T-79）。调用方带合法 X-Request-Id 则沿用，否则服务端生成 12 位 hex。",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "未预期异常（`error_code=internal`）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "请求追踪标识（v6.0 T-79）。调用方可自带 X-Request-Id（合法则沿用，否则新生成 12 位 hex）",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "探测所需资源不可用（`error_code=not-configured` / `browser-unavailable`）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "请求追踪标识（v6.0 T-79）。调用方可自带 X-Request-Id（合法则沿用，否则新生成 12 位 hex）",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "504": {
            "description": "探测超时（`error_code=timeout`）：目标站响应太慢，或出口被限速",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "请求追踪标识（v6.0 T-79）。调用方可自带 X-Request-Id（合法则沿用，否则新生成 12 位 hex）",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "探测目标站用了什么防护（JSON body）",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "探测结论 + 建议路由",
            "headers": {
              "X-Request-Id": {
                "description": "请求级追踪标识（v6.0 T-79）。调用方带合法 X-Request-Id 则沿用，否则服务端生成 12 位 hex。",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "参数非法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "请求级追踪标识（v6.0 T-79）。调用方带合法 X-Request-Id 则沿用，否则服务端生成 12 位 hex。",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized",
            "headers": {
              "X-Request-Id": {
                "description": "请求级追踪标识（v6.0 T-79）。调用方带合法 X-Request-Id 则沿用，否则服务端生成 12 位 hex。",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "413": {
            "description": "请求体超限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "请求级追踪标识（v6.0 T-79）。调用方带合法 X-Request-Id 则沿用，否则服务端生成 12 位 hex。",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/Busy",
            "headers": {
              "X-Request-Id": {
                "description": "请求级追踪标识（v6.0 T-79）。调用方带合法 X-Request-Id 则沿用，否则服务端生成 12 位 hex。",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "未预期异常（`error_code=internal`）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
