+/// Maximum nested function calls per run. Legitimate handlers stay dozens of frames deep; a
+/// deeper chain cannot unwind (see [`Run::body`]) and marks the call unsupported instead.
+pub(crate) const MAXIMUM_CALL_DEPTH: usize = 256;
+
 impl<'ast> Run<'ast, '_> {
     pub(super) fn statement(&mut self, statement: &'ast Stmt) -> Evaluation<'ast, Flow<'ast>> {
         self.execute_all(&plan::scoped(slice::from_ref(statement)), &mut [])
@@ -62,9 +66,17 @@ impl<'ast> Run<'ast, '_> {
         body: &[Statement<'ast>],
         locals: &mut Locals<'ast>,
     ) -> Evaluation<'ast, Value<'ast>> {
+        // A call cycle (self- or mutually recursive handlers) never reaches the statement
+        // budget or the loop cap; each level also clones its symbolic arguments, so even a
+        // million-statement budget cannot end it. Fail the call structurally instead.
+        if self.depth >= MAXIMUM_CALL_DEPTH {
+            return Err(Stop::unsupported("a call past the depth limit"));
+        }
+        self.depth += 1;
         self.frames.push(frame);
         let flow = self.execute_all(body, locals);
         self.frames.pop();
+        self.depth -= 1;
         match flow? {
             Flow::Return(value) => Ok(value),
             _ => Ok(Value::Undefined),
